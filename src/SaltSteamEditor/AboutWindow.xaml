<ui:FluentWindow x:Class="SaltSteamEditor.AboutWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                Title="关于 Salt Steam 状态编辑器" Width="740" Height="600" MinWidth="560" MinHeight="420"
                FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14"
                Foreground="{DynamicResource Ink}" Background="{DynamicResource Canvas}"
                ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Title="关于" ShowMaximize="False" ShowMinimize="False" ButtonsForeground="{DynamicResource Ink}"/>
        <StackPanel Grid.Row="1" Margin="24,16,24,20">
            <TextBlock Text="Salt Steam 状态编辑器" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="SaltSteamPlugin 的独立可视化配套工具。" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
            <TextBlock x:Name="VersionText" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
            <TextBlock Text="第三方许可" FontWeight="SemiBold" Margin="0,20,0,0"/>
        </StackPanel>
        <ui:TextBox x:Name="NoticeText" Grid.Row="2" Margin="24,0,24,24" IsReadOnly="True"
                    Background="{DynamicResource Inset}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Stroke}"
                    TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                    FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" AutomationProperties.Name="第三方许可全文"/>
    </Grid>
</ui:FluentWindow>
