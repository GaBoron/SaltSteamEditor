<ui:FluentWindow x:Class="SaltSteamEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Salt Steam 状态编辑器" Width="1240" Height="900" MinWidth="1020" MinHeight="760"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource Ink}"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" Background="{DynamicResource Canvas}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Closing="OnClosing" PreviewKeyDown="OnKeyDown">
    <Border Background="{DynamicResource Canvas}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>
            <ui:TitleBar x:Name="AppTitleBar" Title="Salt Steam 状态编辑器" FontSize="12" Padding="16,0,0,0" ButtonsForeground="{DynamicResource Ink}">
                <ui:TitleBar.Icon><ui:SymbolIcon Symbol="MusicNote224" FontSize="16" Foreground="{DynamicResource Accent}"/></ui:TitleBar.Icon>
            </ui:TitleBar>
            <Grid Grid.Row="1" Margin="32,22,32,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="状态模板" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="组合音乐信息，定制 Steam 好友看到的状态。" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button x:Name="ThemeButton" Content="浅色" Appearance="Transparent" Icon="{ui:SymbolIcon WeatherSunny24}" Click="ThemeClick" Margin="0,0,16,0"/>
                    <ui:Button Content="另存为" Click="SaveAsClick" Margin="0,0,8,0"/>
                    <ui:Button x:Name="SaveButton" Content="保存配置" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Click="SaveClick"
                               Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" BorderBrush="{DynamicResource Accent}"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="6" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="8" Margin="0,24,0,0">
                    <DockPanel>
                        <ui:Button Content="打开配置" Icon="{ui:SymbolIcon FolderOpen24}" Click="OpenClick" Appearance="Transparent" Margin="0,0,4,0" ToolTip="打开 config.json（Ctrl+O），也可拖入文件" DockPanel.Dock="Left"/>
                        <ui:Button x:Name="ReloadButton" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="ReloadClick" Style="{StaticResource ToolButton}" IsEnabled="False" ToolTip="重新读取配置" AutomationProperties.Name="重新读取" DockPanel.Dock="Right"/>
                        <Border Width="1" Background="{DynamicResource Stroke}" Margin="8,5,16,5" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="FileLabel" Text="打开原插件的 config.json，或先设计再另存为。" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </DockPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="2" Margin="32,0,32,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="392"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="模板编辑" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button x:Name="UndoButton" Icon="{ui:SymbolIcon ArrowUndo24}" Click="UndoClick" Style="{StaticResource ToolButton}" IsEnabled="False" ToolTip="撤销（Ctrl+Z）" AutomationProperties.Name="撤销"/>
                                    <ui:Button x:Name="RedoButton" Icon="{ui:SymbolIcon ArrowRedo24}" Click="RedoClick" Style="{StaticResource ToolButton}" IsEnabled="False" ToolTip="重做（Ctrl+Y）" AutomationProperties.Name="重做"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="PresetBox" DisplayMemberPath="Name" AutomationProperties.Name="常用模板预设"/>
                                <ui:Button Grid.Column="1" Content="应用预设" Click="PresetClick" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="状态内容" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="点选片段来调整顺序，或修改其中的固定文字。" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                            <ListBox x:Name="SegmentList" BorderThickness="1" BorderBrush="{DynamicResource Stroke}" Background="{DynamicResource Inset}"
                                     MinHeight="120" Padding="12" SelectionChanged="SegmentSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="模板片段，按顺序排列">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,8,8"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="FocusRing" CornerRadius="6" BorderBrush="Transparent" BorderThickness="2" Padding="2">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusRing" Property="Background" Value="{DynamicResource Stroke}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="SegmentBorder" Background="{DynamicResource TokenFill}" CornerRadius="4" Padding="12,10" MaxWidth="380">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon x:Name="SegmentIcon" Symbol="Tag24" Foreground="{DynamicResource Accent}" FontSize="16" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="SegmentLabel" Text="{Binding Label}" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsField}" Value="False">
                                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource Surface}"/>
                                                <Setter TargetName="SegmentLabel" Property="Text" Value="{Binding Text}"/>
                                                <Setter TargetName="SegmentLabel" Property="Foreground" Value="{DynamicResource Ink}"/>
                                                <Setter TargetName="SegmentIcon" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <DockPanel Margin="0,10,0,20">
                                <ui:Button x:Name="LeftButton" Icon="{ui:SymbolIcon ChevronLeft24}" Click="MoveLeftClick" Style="{StaticResource ToolButton}" IsEnabled="False" ToolTip="左移片段" AutomationProperties.Name="左移"/>
                                <ui:Button x:Name="RightButton" Icon="{ui:SymbolIcon ChevronRight24}" Click="MoveRightClick" Style="{StaticResource ToolButton}" IsEnabled="False" ToolTip="右移片段" AutomationProperties.Name="右移"/>
                                <ui:Button x:Name="RemoveButton" Icon="{ui:SymbolIcon Delete24}" Click="RemoveClick" Style="{StaticResource ToolButton}" IsEnabled="False" ToolTip="移除片段" AutomationProperties.Name="移除片段"/>
                                <TextBlock x:Name="SelectionHint" Text="未选择片段" Style="{StaticResource Hint}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Grid x:Name="LiteralPanel" Visibility="Collapsed" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="LiteralBox" AutomationProperties.Name="选中片段的固定文字"/>
                                <ui:Button Grid.Column="1" Content="更新文字" Click="UpdateLiteralClick" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="添加字段" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="FieldButtons">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{Binding Name}" Tag="{Binding Token}" ToolTip="{Binding Token}" Click="InsertFieldClick" Margin="0,0,8,8" Padding="12,7"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,8,0,24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="NewLiteralBox" Text=" · " PlaceholderText="输入固定文字，例如 正在听" AutomationProperties.Name="要插入的固定文字"/>
                                <ui:Button Grid.Column="1" Content="插入文字" Icon="{ui:SymbolIcon Add24}" Click="InsertLiteralClick" Margin="8,0,0,0"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,0,0,20"/>
                            <Expander x:Name="SourceExpander" Header="模板文本" IsExpanded="False">
                                <StackPanel Margin="0,12,0,0">
                                    <ui:TextBox x:Name="TemplateBox" TextChanged="TemplateChanged" GotKeyboardFocus="TemplateFocused"
                                                MinHeight="78" AcceptsReturn="False" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI"
                                                AutomationProperties.Name="songFormat 模板文本"/>
                                    <TextBlock Text="字段会插入到选中片段之后；编辑模板文本时，可在光标处插入。" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="实时预览" Style="{StaticResource SectionTitle}"/>
                            <Border HorizontalAlignment="Right" CornerRadius="4" Background="{DynamicResource Surface}" Padding="8,3">
                                <TextBlock Text="示例数据" Style="{StaticResource Hint}"/>
                            </Border>
                        </Grid>
                        <Border Background="#18222F" CornerRadius="8" BorderBrush="#33414F" BorderThickness="1" Padding="24">
                            <StackPanel>
                                <Grid Margin="0,0,0,22">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="#2D4155" CornerRadius="6" HorizontalAlignment="Left">
                                        <ui:SymbolIcon Symbol="Person24" FontSize="22" Foreground="#97B2C9"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Steam 好友" Foreground="#D6E0E9" FontSize="14"/>
                                        <TextBlock Text="正在游戏" Foreground="#A5CD78" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border BorderBrush="#8BBF66" BorderThickness="3,0,0,0" Padding="14,2,0,2">
                                    <StackPanel>
                                        <TextBlock Text="Salt Player for Windows" Foreground="#B4D88B" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="PreviewText" Foreground="#A4CA7F" FontSize="16" LineHeight="25"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="本地效果示意 · 不会向 Steam 发送状态" Foreground="#9EAFBE" FontSize="12" Margin="0,22,0,0"/>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,10,0,14">
                            <ui:Button Content="复制" Icon="{ui:SymbolIcon Copy24}" Click="CopyPreviewClick" Appearance="Transparent" DockPanel.Dock="Right" Padding="8,6"/>
                            <TextBlock x:Name="LengthLabel" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource Muted}" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock Grid.Column="1" x:Name="ValidationText" Style="{StaticResource Hint}"/>
                        </Grid>
                        <Border Background="{DynamicResource Surface}" CornerRadius="8" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="20">
                            <StackPanel>
                                <TextBlock Text="预览数据" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <ComboBox x:Name="SampleMode" SelectionChanged="SampleModeChanged" SelectedIndex="0" AutomationProperties.Name="示例数据场景">
                                    <ComboBoxItem Content="普通歌曲"/>
                                    <ComboBoxItem Content="无歌词 / 缺少专辑信息"/>
                                    <ComboBoxItem Content="长标题与长歌词"/>
                                </ComboBox>
                                <Expander Header="编辑示例内容" IsExpanded="False" Margin="0,16,0,0">
                                    <ItemsControl x:Name="SampleFields" Margin="0,14,0,0">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,8,12">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                                    <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="保存后切回 SPW 查看。若状态未变化，可切歌或重新启用原插件。" Style="{StaticResource Hint}" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="3" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="32,0">
                <TextBlock x:Name="StatusText" Text="就绪。可先尝试一个预设。" Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
