<Window x:Class="SaltSteamEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salt Steam 状态编辑器" Width="1240" Height="880" MinWidth="1000" MinHeight="720"
        Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver"
        Closing="OnClosing" PreviewKeyDown="OnKeyDown">
    <Border Background="#F2F6FA" Padding="28,22,28,16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,20">
            <Border Width="46" Height="46" Background="#176C9C" CornerRadius="12" Margin="0,0,14,0" DockPanel.Dock="Left">
                <TextBlock Text="♫" Foreground="White" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel>
                <TextBlock Text="Salt Steam 状态编辑器" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="把正在听的音乐，组合成你喜欢的状态。" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16,14,16,10" Margin="0,0,0,18">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <Button Content="打开配置…" Click="OpenClick" ToolTip="Ctrl+O，也可将配置文件拖入窗口"/>
                    <Button x:Name="ReloadButton" Content="重新读取" Click="ReloadClick" IsEnabled="False"/>
                    <Button Content="另存为…" Click="SaveAsClick" DockPanel.Dock="Right" Margin="0,0,0,8"/>
                    <Button x:Name="SaveButton" Content="保存到配置" Click="SaveClick" Style="{StaticResource Primary}" DockPanel.Dock="Right"/>
                </DockPanel>
                <TextBlock x:Name="FileLabel" Text="尚未打开配置。可以先设计模板，再另存为 config.json。"
                           Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="8" Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="组合你的状态" Style="{StaticResource SectionTitle}"/>
                        <DockPanel Margin="0,0,0,14">
                            <Button Content="应用预设" Click="PresetClick" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <ComboBox x:Name="PresetBox" DisplayMemberPath="Name" AutomationProperties.Name="常用模板预设"/>
                        </DockPanel>
                        <TextBlock Text="选择片段后可移动或移除；点下方字段可插入新片段。" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                        <ListBox x:Name="SegmentList" BorderThickness="1" BorderBrush="#DCE5EC" Background="#F7FAFC"
                                 MinHeight="94" Padding="8" SelectionChanged="SegmentSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="模板片段，按顺序排列">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="Margin" Value="0,0,5,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="SegmentBorder" Background="#E0F0FA" Padding="12,8" CornerRadius="4" MaxWidth="420">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Foreground="#176C9C" FontSize="11" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding Text}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsField}" Value="False">
                                            <Setter TargetName="SegmentBorder" Property="Background" Value="#EDF0F4"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,10,0,4">
                            <Button x:Name="LeftButton" Content="左移" Click="MoveLeftClick" Padding="12,6" IsEnabled="False"/>
                            <Button x:Name="RightButton" Content="右移" Click="MoveRightClick" Padding="12,6" IsEnabled="False"/>
                            <Button x:Name="RemoveButton" Content="移除片段" Click="RemoveClick" Padding="12,6" IsEnabled="False"/>
                            <Button x:Name="UndoButton" Content="撤销" Click="UndoClick" Padding="12,6" IsEnabled="False"/>
                            <Button x:Name="RedoButton" Content="重做" Click="RedoClick" Padding="12,6" IsEnabled="False"/>
                        </WrapPanel>
                        <DockPanel x:Name="LiteralPanel" Visibility="Collapsed" Margin="0,0,0,14">
                            <Button Content="更新文字" Click="UpdateLiteralClick" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <TextBox x:Name="LiteralBox" AutomationProperties.Name="选中片段的固定文字"/>
                        </DockPanel>
                        <TextBlock Text="添加内容" FontWeight="SemiBold" Margin="0,6,0,10"/>
                        <ItemsControl x:Name="FieldButtons">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Tag="{Binding Token}" ToolTip="{Binding Token}" Click="InsertFieldClick" Padding="12,7"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,20">
                            <Button Content="插入文字" Click="InsertLiteralClick" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                            <TextBox x:Name="NewLiteralBox" Text=" · " AutomationProperties.Name="要插入的固定文字"/>
                        </DockPanel>
                        <TextBlock Text="模板文本" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox x:Name="TemplateBox" TextChanged="TemplateChanged" GotKeyboardFocus="TemplateFocused"
                                 MinHeight="82" AcceptsReturn="False" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Code, Consolas, Microsoft YaHei UI"
                                 AutomationProperties.Name="songFormat 模板文本"/>
                        <TextBlock Text="可直接输入；字段按钮会插入到选中片段之后，或文本光标处。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="状态预览" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#1B2838" CornerRadius="8" Padding="22" MinHeight="180">
                        <StackPanel>
                            <TextBlock Text="你的 Steam 好友视角" Foreground="#AEBECF" FontSize="12" Margin="0,0,0,18"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="40" Background="#375370" BorderBrush="#709AC0" BorderThickness="1" VerticalAlignment="Top">
                                    <TextBlock Text="♫" Foreground="#BDE1F4" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Salt Player for Windows" Foreground="#B6D986" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="PreviewText" Foreground="#9FC56B" FontSize="16" LineHeight="24"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="本地示意，使用下方示例数据；不会连接 Steam。" Foreground="#AEBECF" FontSize="11" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Border>
                    <DockPanel Margin="0,12,0,8">
                        <Button Content="复制预览" Click="CopyPreviewClick" DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0"/>
                        <TextBlock x:Name="LengthLabel" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Background="#E7EFF6" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                        <TextBlock x:Name="ValidationText" FontSize="12" Foreground="#36536D"/>
                    </Border>
                    <Expander Header="自定义预览数据" IsExpanded="True" FontWeight="SemiBold">
                        <StackPanel Margin="0,14,0,0">
                            <ComboBox x:Name="SampleMode" SelectionChanged="SampleModeChanged" SelectedIndex="0" AutomationProperties.Name="示例数据场景">
                                <ComboBoxItem Content="普通歌曲"/>
                                <ComboBoxItem Content="无歌词 / 缺少专辑信息"/>
                                <ComboBoxItem Content="长标题与长歌词"/>
                            </ComboBox>
                            <ItemsControl x:Name="SampleFields" Margin="0,12,0,0" FontWeight="Normal">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,10,10">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="保存后由原插件读取配置。若状态未变化，可切歌或重新启用插件。Steam 状态不会逐帧刷新。"
                               Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="就绪。打开 SaltSteamPlugin 的 config.json，或先试试预设。"
                   Style="{StaticResource Hint}" Margin="0,14,0,0" MaxHeight="65"/>
    </Grid>
    </Border>
</Window>
