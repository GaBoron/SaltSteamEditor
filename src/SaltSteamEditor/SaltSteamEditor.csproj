<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SaltSteamEditor</AssemblyName>
    <Product>Salt Steam 状态编辑器</Product>
    <Description>SaltSteamPlugin 独立可视化模板编辑器</Description>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <EmbeddedResource Include="../../licenses/*" LogicalName="Notices.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(RuntimeNoticeDirectory)/*" LogicalName="Notices.%(Filename)%(Extension)" Condition="'$(RuntimeNoticeDirectory)' != ''" />
  </ItemGroup>
  <Target Name="RequireRuntimeNotices" BeforeTargets="PrepareForBuild" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Condition="!Exists('$(RuntimeNoticeDirectory)')" Text="请通过 Publish-Portable.ps1 构建单文件，以包含对应运行时的许可。" />
  </Target>
</Project>
